# Web 端运行时配置（Nuxt runtimeConfig.public.apiBase）
NUXT_PUBLIC_API_BASE=http://localhost:8080

# API 监听端口（Go 端读取；缺省 8080）
PORT=8080

# 本地数据库（compose 消费；task db:up / db:down，见 docs/guides/onboarding.md）
POSTGRES_USER=learnfolio
POSTGRES_PASSWORD=learnfolio
POSTGRES_DB=learnfolio
# 宿主侧端口；与本机已有 PG 或其他工作树冲突时改这里错开
POSTGRES_PORT=5432

# DATABASE_URL（Phase 2 Go 消费，届时取消注释；拼装格式如下，值须与上方 POSTGRES_* 一致）
# DATABASE_URL=postgres://learnfolio:learnfolio@localhost:5432/learnfolio?sslmode=disable

# REDIS_ADDR（Phase 2 Go 消费，届时与 infra/docker-compose.yml 的 Redis 注释服务同批启用）
# REDIS_ADDR=localhost:6379
